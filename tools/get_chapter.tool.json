{
  "name": "get_chapter",
  "description": "Get details for a specific chapter in a book. Supports nested hierarchies.",
  "displayName": "获取章节详情",
  "category": "read",
  "endpoint": "GET /api/study/books/<book_title>/chapters/<chapter_title>",
  "inputSchema": {
    "type": "object",
    "properties": {
      "book_title": {
        "type": "string",
        "description": "Book title"
      },
      "chapter_title": {
        "type": "string",
        "description": "Chapter title"
      }
    },
    "required": [
      "book_title",
      "chapter_title"
    ]
  },
  "examples": [
    {
      "description": "获取章节详情",
      "input": {
        "book_title": "控制论",
        "chapter_title": "绪论"
      }
    }
  ],
  "outputSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      }
    }
  }
}